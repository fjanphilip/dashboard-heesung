# Broker MQTT bawaan aplikasi (tidak perlu Mosquitto/Docker)
BROKER_ENABLED=1
BROKER_BIND=0.0.0.0
BROKER_PORT=1883
BROKER_MAX_CONNECTIONS=50

# Dashboard terhubung ke broker di proses yang sama
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

TOPIC_PREFIX=heesung
RELAY_COUNT=4
DB_PATH=data/heesung.db

# Buka browser otomatis saat server start (1 = ya)
OPEN_BROWSER=0
